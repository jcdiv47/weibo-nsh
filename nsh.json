{
  "name": "Weibo",
  "id": "com.example.weibo",
  "version": "0.1.0",
  "build": 1,
  "appearance": "system",
  "theme": "theme.json",
  "tailwind": {
    "fontSize": {
      "fine": 11,
      "meta": [
        13,
        1.3846153846
      ],
      "body": [
        15,
        1.6
      ],
      "headline": [
        17,
        1.2941176471
      ],
      "title": [
        22,
        1.2727272727
      ],
      "large-title": [
        34,
        1.2058823529
      ]
    },
    "radius": {
      "pic": 6,
      "well": 10,
      "sheet": 28
    }
  },
  "window": {
    "title": "Weibo",
    "defaultSize": {
      "width": 1240,
      "height": 820
    },
    "minSize": {
      "width": 940,
      "height": 560
    },
    "titleBar": {
      "style": "hidden",
      "height": 52
    }
  },
  "capabilities": {
    "webview": {
      "hosts": [
        "weibo.com",
        "*.weibo.com",
        "weibo.cn",
        "*.weibo.cn",
        "*.sina.com.cn",
        "*.sina.cn",
        "*.sinaimg.cn",
        "*.geetest.com",
        "*.weibocdn.com"
      ]
    },
    "network": {
      "hosts": [
        "*.sinaimg.cn",
        "*.weibocdn.com",
        "face.t.sinajs.cn"
      ]
    },
    "statusBar": true,
    "openUrl": {
      "schemes": [
        "http",
        "https"
      ]
    },
    "share": true,
    "application": true,
    "clipboard": true,
    "homeDir": true,
    "fs": {
      "read": [
        "${dataDir}/downloads",
        "${homeDir}/Downloads"
      ],
      "write": [
        "${dataDir}/downloads",
        "${homeDir}/Downloads"
      ]
    }
  },
  "ios": {
    "infoPlist": {
      "NSPhotoLibraryAddUsageDescription": "Weibo saves the pictures and videos you choose to your photo library."
    }
  }
}
